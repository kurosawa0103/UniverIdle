      - "\\u003cshake\\u003e\u8981\u662F\u4E0D\u7528\u5728\u7926\u5751\u88E1\u2026\u5C31\u597D\u4E86\\u003c/shake\\u003e"
      - "\\u003cshake\\u003eIf only I didn't have to be down here\u2026 in the mines\\u003c/shake\\u003e"
      - "\\u003cshake\\u003e\u3053\u3093\u306A\u9271\u5C71\u3067\u50CD\u304B\u306A\u304F\u3066\u6E08\u3080\u306A\u3089\u2026\u3088\u304B\u3063\u305F\u306E\u306B\\u003c/shake\\u003e"
