    - Term: "\u4E0B\u5C42\u8857\u9053-\u8D77\u59CB\u7684\u97F3\u4E50\u63CF\u8FF0"
      TermType: 0
      Description: 
      Languages:
      - "\u4ECE\u767D\u8272\u7684\u623F\u95F4\u542F\u7A0B\uFF0C\u8FDC\u5904\u98CE\u8F66\u5E73\u539F\u548C\u65CB\u5F8B\u5728\u98D8\u52A8\uFF0C\u5728\u4E0D\u8D77\u773C\u7684\u89D2\u843D\u91CC\u4F3C\u4E4E\u6709\u4E00\u6247\u5C01\u95ED\u7684\u5927\u95E8\uFF0C\u800C\u82CF\u9192\u7684\u4F60\u5728\u8FD9\u91CC\u5F00\u59CB\u6F2B\u6E38\u3002\u4F46\u662F\u6CA1\u5173\u7CFB\u54E6\uFF0C\u9A7B\u8DB3\u4E8E\u6B64\uFF0C\u53EF\u4EE5\u6162\u6162\u8046\u542C\uFF0C\u4E00\u5207\u624D\u521A\u521A\u5F00\u59CB\u5462\u3002"
