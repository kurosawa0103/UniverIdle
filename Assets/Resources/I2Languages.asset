    - Term: "\u5DF2\u7ECF\u6709\u5B58\u6863\u4E86\u54E6 \u786E\u8BA4\u5F00\u59CB\u65B0\u7684\u6E38\u620F\u5417"
      TermType: 0
      Description: 
      Languages:
      - "\u5DF2\u7ECF\u6709\u5B58\u6863\u4E86\u54E6\uFF0C\u60F3\u8981\u5F00\u59CB\u65B0\u7684\u6E38\u620F\u5417\uFF1F"
      - "\u5DF2\u7D93\u6709\u5B58\u6A94\u4E86\u54E6\uFF0C\u60F3\u8981\u958B\u59CB\u65B0\u7684\u904A\u6232\u55CE\uFF1F"
      - You already have a save. Start a new game anyway?
      - "\u30BB\u30FC\u30D6\u30C7\u30FC\u30BF\u304C\u3042\u308A\u307E\u3059\u3088\u3002\u65B0\u3057\u304F\u59CB\u3081\u307E\u3059\u304B\uFF1F"
      - "\uC774\uBBF8 \uC800\uC7A5\uB41C \uAC8C\uC784\uC774 \uC788\uC5B4\uC694. \uC0C8\uB85C\uC6B4
        \uAC8C\uC784\uC744 \uC2DC\uC791\uD560\uAE4C\uC694?"
      - 
      Flags: 000000000000
      Languages_Touch: []
    - Term: "\u6CA1\u6709\u627E\u5230\u5B58\u6863 \u662F\u5426\u5F00\u59CB\u65B0\u6E38\u620F "
      TermType: 0
      Description: 
      Languages:
      - "\u6CA1\u6709\u627E\u5230\u5B58\u6863\uFF0C\u662F\u5426\u5F00\u59CB\u65B0\u6E38\u620F\uFF1F"
      - "\u672A\u627E\u5230\u5B58\u6A94\uFF0C\u662F\u5426\u958B\u59CB\u65B0\u904A\u6232\uFF1F"
      - No save data found. Start a new game?
      - "\u30BB\u30FC\u30D6\u30C7\u30FC\u30BF\u304C\u898B\u3064\u304B\u308A\u307E\u305B\u3093\u3002\u65B0\u3057\u3044\u30B2\u30FC\u30E0\u3092\u958B\u59CB\u3057\u307E\u3059\u304B\uFF1F"
      - "\uC800\uC7A5\uB41C \uAC8C\uC784\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC5B4\uC694.
        \uC0C8\uB85C\uC6B4 \uAC8C\uC784\uC744 \uC2DC\uC791\uD560\uAE4C\uC694?"
      - 
      Flags: 000000000000
