      - "\u597D\u7528\u7684\u9493\u7AFF\\n\\n\u5389\u5BB3\u7684\u9493\u7AFF\\n\\n\u4E0D\u5982\u8FD9\u6839\u987A\u624B\u7684\\n\\n\u8001\u65E7\u9493\u7AFF"
      - "\u597D\u7528\u7684\u91E3\u7AFF\\n\\n\u53B2\u5BB3\u7684\u91E3\u7AFF\\n\\n\u4E0D\u5982\u9019\u6839\u9806\u624B\u7684\\n\\n\u8001\u820A\u91E3\u7AFF"
      - Good Rod.\n\nSuper Rod.\n\nBut none feel quite as right\n\nas this Old Rod.
      - "\u3044\u3044\u3064\u308A\u3056\u304A\u3002\\n\\n\u3059\u3054\u3044\u3064\u308A\u3056\u304A\u3002\\n\\n\u3067\u3082\u3001\\n\u3044\u3061\u3070\u3093\u624B\u306B\u306A\u3058\u3080\u306E\u306F\\n\\n\u3053\u306E\u30DC\u30ED\u306E\u3064\u308A\u3056\u304A\u3002"
