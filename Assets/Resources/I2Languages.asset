    - Term: "\u5F00\u6EE1\u98CE\u8F66\u82B1\u7684\u5E73\u539F\u7684\u97F3\u4E50\u63CF\u8FF0"
      TermType: 0
      Description: 
      Languages:
      - "\u5FAE\u98CE\u5439\u8FC7\u539F\u91CE\uFF0C\u98CE\u8F66\u82B1\u8F7B\u8F7B\u6447\u66F3\u3002\u5B83\u4E00\u76F4\u6E29\u67D4\u5730\u966A\u4F34\u7740\u6BCF\u4E00\u53EA\u5BFB\u627E\u300C\u5B9D\u7269\u300D\u7684
        Luby\u3002\u5F53\u719F\u6089\u7684\u65CB\u5F8B\u518D\u6B21\u54CD\u8D77\uFF0C\u9057\u5FD8\u7684\u6211\u4EEC\u4E5F\u7EC8\u5C06\u518D\u6B21\u60F3\u8D77\u5F7C\u6B64\uFF0C\u56E0\u4E3AShio\u662F\u6211\u4EEC\u7684\u670B\u53CB\u5462\u3002"
