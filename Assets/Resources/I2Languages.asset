    - Term: "\u9713\u8679\u665A\u98CE\u7684\u97F3\u4E50\u63CF\u8FF0"
      TermType: 0
      Description: 
      Languages:
      - "\u9713\u8679\u70B9\u4EAE\u4E86\u6D77\u5E95\u90FD\u5E02\u7684\u591C\u665A\uFF0C\u8F7B\u5FEB\u800C\u5145\u6EE1\u6D3B\u529B\u7684\u65CB\u5F8B\u968F\u7740\u665A\u98CE\u6D41\u6DCC\u3002\u5728\u5C4B\u9876\u773A\u671B\u8FD9\u5EA7\u6C38\u4E0D\u5165\u7720\u7684\u57CE\u5E02\uFF0C\u804A\u804A\u5929\u3001\u5439\u5439\u98CE\uFF0C\u518D\u542C\u542C\u4E00\u4F4D\u732B\u8033\u5C11\u5973\u5206\u4EAB\u5979\u5173\u4E8E\u68A6\u60F3\u7684\u5C0F\u79D8\u5BC6\u3002\u4ECA\u665A\uFF0C\u5C31\u6682\u65F6\u5FD8\u6389\u70E6\u607C\uFF0C\u4EAB\u53D7\u8FD9\u5EA7\u57CE\u5E02\u72EC\u6709\u7684\u70ED\u95F9\u5427\u3002"
