      - "\u5411\u661F\u7A7A\u7948\u9858"
      - Wishing Upon the Stars
      - "\u661F\u7A7A\u3078\u306E\u9858\u3044"
      - "\uBCC4\uD558\uB298\uC5D0 \uC18C\uC6D0\uC744 \uBE4C\uB2E4"
