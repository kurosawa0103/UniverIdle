    - Term: "\u5411\u661F\u7A7A\u7948\u613F\u7684\u97F3\u4E50\u63CF\u8FF0"
      TermType: 0
      Description: 
      Languages:
      - "\u6C99\u6F20\u7684\u591C\u665A\u6CA1\u6709\u58F0\u97F3\uFF0C\u53EA\u6709\u6D41\u661F\u56DE\u5E94\u7740\u6F2B\u957F\u7684\u7B49\u5F85\u3002\u90A3\u4E9B\u88AB\u9057\u5FD8\u7684\u613F\u671B\u3001\u88AB\u98CE\u6C99\u5439\u6563\u7684\u6545\u4E8B\uFF0C\u968F\u7740\u6D41\u661F\u518D\u6B21\u6D6E\u73B0\u3002\u90A3\u4E48\u542C\u7740\u8FD9\u9996\u66F2\u5B50\uFF0C\u4E00\u8D77\u6765\u7948\u613F\u5427\u3002"
      - "\u6C99\u6F20\u7684\u591C\u665A\u6C92\u6709\u8072\u97F3\uFF0C\u53EA\u6709\u6D41\u661F\u56DE\u61C9\u8457\u6F2B\u9577\u7684\u7B49\u5F85\u3002\u90A3\u4E9B\u88AB\u907A\u5FD8\u7684\u9858\u671B\u3001\u88AB\u98A8\u6C99\u5439\u6563\u7684\u6545\u4E8B\uFF0C\u96A8\u8457\u6D41\u661F\u518D\u6B21\u6D6E\u73FE\u3002\u90A3\u9EBC\u807D\u8457\u9019\u9996\u66F2\u5B50\uFF0C\u4E00\u8D77\u4F86\u7948\u9858\u5427\u3002"
      - "The desert night holds no sound{c} only shooting stars answer the long wait.
        Forgotten wishes{c} stories scattered by wind and sand\u2014they rise again
        with the meteors. Listen to this melody{c} and let us wish together."
      - "\u7802\u6F20\u306E\u591C\u306B\u306F\u97F3\u304C\u306A\u3044\u3002\u305F\u3060\u6D41\u308C\u661F\u304C\u9577\u3044\u5F85\u3061\u6642\u9593\u306B\u5FDC\u3048\u3066\u3044\u308B\u3002\u5FD8\u308C\u53BB\u3089\u308C\u305F\u9858\u3044\u3001\u98A8\u7802\u306B\u5439\u304D\u6563\u3089\u3055\u308C\u305F\u7269\u8A9E\u304C\u3001\u6D41\u661F\u3068\u5171\u306B\u518D\u3073\u6D6E\u304B\u3073\u4E0A\u304C\u308B\u3002\u3053\u306E\u66F2\u3092\u8074\u304D\u306A\u304C\u3089\u3001\u4E00\u7DD2\u306B\u7948\u308A\u3092\u6367\u3052\u3088\u3046\u3002"
      - "\uC0AC\uB9C9\uC758 \uBC24\uC5D0\uB294 \uC18C\uB9AC\uAC00 \uC5C6\uACE0, \uC624\uC9C1
        \uC720\uC131\uB9CC\uC774 \uAE34 \uAE30\uB2E4\uB9BC\uC5D0 \uB2F5\uD55C\uB2E4.
        \uC78A\uD600\uC9C4 \uC18C\uC6D0\uB4E4, \uBAA8\uB798\uBC14\uB78C\uC5D0 \uD769\uC5B4\uC9C4
        \uC774\uC57C\uAE30\uB4E4\uC774 \uC720\uC131\uACFC \uD568\uAED8 \uB2E4\uC2DC
        \uB5A0\uC624\uB978\uB2E4. \uC774 \uACE1\uC744 \uB4E4\uC73C\uBA70, \uD568\uAED8
        \uC18C\uC6D0\uC744 \uBE4C\uC5B4\uBCF4\uC790."
      - 
      Flags: 000000000000
      Languages_Touch: []
    - Term: "\u81F4\u6F02\u6D41\u4E8E\u788E\u7247\u4E2D\u7684\u4F60"
      TermType: 0
      Description: 
      Languages:
      - "\u81F4\u6F02\u6D41\u4E8E\u788E\u7247\u4E2D\u7684\u4F60"
      - "\u81F4\u6F02\u6D41\u65BC\u788E\u7247\u4E2D\u7684\u4F60"
      - To You{c} Adrift in Fragments
      - "\u7834\u7247\u306E\u4E2D\u3092\u6F02\u3046\u541B\u3078"
      - "\uD30C\uD3B8 \uC18D\uC744 \uB5A0\uB3C4\uB294 \uB108\uC5D0\uAC8C"
      - 
      Flags: 000000000000
      Languages_Touch: []
    - Term: "\u81F4\u6F02\u6D41\u4E8E\u788E\u7247\u4E2D\u7684\u4F60\u7684\u97F3\u4E50\u63CF\u8FF0"
      TermType: 0
      Description: 
      Languages:
      - "\u8FD9\u662F\u9001\u7ED9\u6F02\u6D41\u5728\u8FF7\u56E0\u7A7A\u95F4\u7684\u4F60\u7684\u66F2\u5B50\uFF0C\u4F60\u4E5F\u627E\u5230\u4E86\u5C5E\u4E8E\u81EA\u5DF1\u7684\u8FF7\u56E0\u4E86\u5427\uFF0C\u5982\u679C\u8FD8\u6CA1\u6709\u7684\u8BDD\u4E5F\u4E0D\u80FD\u7070\u5FC3\u54E6\uFF0C\u8FF7\u56E0\u7684\u79CD\u5B50\u5DF2\u7ECF\u5728\u4F60\u7684\u5FC3\u4E2D\u64AD\u79CD\u4E86\uFF0C\u4E5F\u8BB8\u5728\u5C06\u6765\u4F60\u4E5F\u4F1A\u8BDE\u751F\u5C5E\u4E8E\u81EA\u5DF1\u7684\u8FF7\u56E0\uFF01"
      - "\u9019\u662F\u9001\u7D66\u6F02\u6D41\u5728\u8FF7\u56E0\u7A7A\u9593\u7684\u4F60\u7684\u66F2\u5B50,\u4F60\u4E5F\u627E\u5230\u4E86\u5C6C\u65BC\u81EA\u5DF1\u7684\u8FF7\u56E0\u4E86\u5427,\u5982\u679C\u9084\u6C92\u6709\u7684\u8A71\u4E5F\u4E0D\u80FD\u7070\u5FC3\u54E6,\u8FF7\u56E0\u7684\u7A2E\u5B50\u5DF2\u7D93\u5728\u4F60\u7684\u5FC3\u4E2D\u64AD\u7A2E\u4E86,\u4E5F\u8A31\u5728\u5C07\u4F86\u4F60\u4E5F\u6703\u8A95\u751F\u5C6C\u65BC\u81EA\u5DF1\u7684\u8FF7\u56E0!"
      - "This melody is for you{c} drifting through meme-space. Perhaps you've found
        your own meme by now\u2014if not{c} don't lose heart. The seed has already
        been planted in your heart{c} and one day your own meme may bloom."
      - "\u3053\u308C\u306F\u30DF\u30FC\u30E0\u7A7A\u9593\u3092\u6F02\u3046\u541B\u306B\u8D08\u308B\u66F2\u3002\u541B\u3082\u81EA\u5206\u306E\u30DF\u30FC\u30E0\u3092\u898B\u3064\u3051\u305F\u3060\u308D\u3046\u304B\u3002\u307E\u3060\u306A\u3089\u8AE6\u3081\u306A\u3044\u3067\u3002\u30DF\u30FC\u30E0\u306E\u7A2E\u306F\u3082\u3046\u541B\u306E\u5FC3\u306B\u8494\u304B\u308C\u3066\u3044\u308B\u3002\u3044\u3064\u304B\u541B\u3060\u3051\u306E\u30DF\u30FC\u30E0\u304C\u751F\u307E\u308C\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
      - "\uC774\uAC83\uC740 \uBC08 \uACF5\uAC04\uC744 \uB5A0\uB3C4\uB294 \uB108\uC5D0\uAC8C
        \uBCF4\uB0B4\uB294 \uACE1\uC774\uC57C. \uB108\uB3C4 \uC774\uBBF8 \uC790\uC2E0\uB9CC\uC758
        \uBC08\uC744 \uCC3E\uC558\uACA0\uC9C0. \uC544\uC9C1 \uBABB \uCC3E\uC558\uC5B4\uB3C4
        \uB099\uC2EC\uD558\uC9C0 \uB9C8. \uBC08\uC758 \uC528\uC557\uC740 \uC774\uBBF8
        \uB124 \uB9C8\uC74C\uC18D\uC5D0 \uBFCC\uB824\uC84C\uC73C\uB2C8, \uC5B8\uC820\uAC00
        \uB108\uB9CC\uC758 \uBC08\uC774 \uD0C4\uC0DD\uD560 \uAC70\uC57C!"
      - 
      Flags: 000000000000
      Languages_Touch: []
    - Term: "\u97F3\u4E50\u4E4B\u95F4\u7684\u97F3\u4E50\u63CF\u8FF0"
      TermType: 0
      Description: 
      Languages:
      - "\u4E00\u9996\u8FD8\u5728\u6210\u957F\u7684\u66F2\u5B50\u3002\u81F3\u5C11\u73B0\u5728\u4E0D\u9700\u8981\u628A\u5B83\u53D8\u5F97\u5B8C\u7F8E\uFF0C\u5728\u4E00\u6B21\u6B21\u7684\u5C1D\u8BD5\u4E0B\uFF0C\u628A\u7075\u611F\u7559\u5728\u65CB\u5F8B\u91CC\u3002\u7136\u540E\u4F1A\u7EC4\u6210\u4E00\u4E9B\u65B0\u7684\u4E8B\u7269\u3002\u8FD9\u4E5F\u662F\u90A3\u679A\u5149\u7403\u4E0D\u65AD\u8FFD\u6C42\u7684\u4E1C\u897F\u3002"
      - 
      - 
      - 
      - 
      - 
      Flags: 000000000000
      Languages_Touch: []
    - Term: "\u5343\u79A7\u5E74\u6F6E\u6D41"
      TermType: 0
      Description: 
      Languages:
      - "\u5343\u79A7\u5E74\u6F6E\u6D41"
      - "\u5343\u79A7\u5E74\u6F6E\u6D41"
      - Millennium Wave
      - "\u30DF\u30EC\u30CB\u30A2\u30E0\u30FB\u30A6\u30A7\u30A4\u30D6"
      - "\uBC00\uB808\uB2C8\uC5C4 \uC6E8\uC774\uBE0C"
      - 
      Flags: 000000000000
      Languages_Touch: []
    - Term: "\u5343\u79A7\u5E74\u6F6E\u6D41\u7684\u97F3\u4E50\u63CF\u8FF0"
      TermType: 0
      Description: 
      Languages:
      - "\u660E\u4EAE\u7684\u7535\u5B50\u65CB\u5F8B\u914D\u5408\u590D\u53E4\u5408\u6210\u5668\uFF0C\u8F7B\u76C8\u800C\u5BCC\u6709\u5F8B\u52A8\u3002\u6D0B\u6EA2\u7740\u5343\u79A7\u5E74\u524D\u5915\u72EC\u6709\u7684\u4E50\u89C2\u4E0E\u61A7\u61AC\uFF0C\u4EFF\u4F5B\u968F\u7740\u5C4F\u5E55\u7F13\u7F13\u4EAE\u8D77\uFF0C\u4E00\u4E2A\u5173\u4E8E\u672A\u6765\u7684\u65F6\u4EE3\u4E5F\u6B63\u6084\u7136\u5C55\u5F00\u3002"
      - "\u660E\u4EAE\u7684\u96FB\u5B50\u65CB\u5F8B\u4F34\u96A8\u5FA9\u53E4\u5408\u6210\u5668\uFF0C\u8F15\u76C8\u800C\u5BCC\u6709\u5F8B\u52D5\u3002\u6D0B\u6EA2\u8457\u5343\u79A7\u5E74\u524D\u5915\u7368\u6709\u7684\u6A02\u89C0\u8207\u61A7\u61AC\uFF0C\u5F77\u5F7F\u96A8\u8457\u87A2\u5E55\u7DE9\u7DE9\u4EAE\u8D77\uFF0C\u4E00\u500B\u95DC\u65BC\u672A\u4F86\u7684\u6642\u4EE3\u4E5F\u6B63\u6084\u7136\u5C55\u958B\u3002"
      - "Bright electronic melodies over vintage synths{c} weightless and alive with
        rhythm. Filled with the singular hope of the millennium's eve \u2014 as if
        a screen slowly brightens{c} and an age of futures quietly begins."
      - "\u660E\u308B\u3044\u96FB\u5B50\u30E1\u30ED\u30C7\u30A3\u30FC\u304C\u61D0\u304B\u3057\u3044\u30B7\u30F3\u30BB\u306B\u4E57\u308A\u3001\u8EFD\u3084\u304B\u306B\u30EA\u30BA\u30E0\u3092\u523B\u3080\u3002\u30DF\u30EC\u30CB\u30A2\u30E0\u306E\u524D\u591C\u306B\u6F02\u3046\u3001\u3042\u306E\u72EC\u7279\u306E\u9AD8\u63DA\u3068\u5922\u2014\u2014\u30B9\u30AF\u30EA\u30FC\u30F3\u304C\u3086\u3063\u304F\u308A\u3068\u706F\u308B\u3088\u3046\u306B\u3001\u672A\u6765\u3068\u3044\u3046\u6642\u4EE3\u304C\u9759\u304B\u306B\u5E55\u3092\u958B\u3051\u308B\u3002"
      - "\uBCF5\uACE0\uD48D \uC2E0\uB514\uC0AC\uC774\uC800 \uC704\uB85C \uD750\uB974\uB294
        \uB9D1\uC740 \uC804\uC790 \uC120\uC728, \uAC00\uBCCD\uACE0 \uC0DD\uB3D9\uAC10
        \uB118\uCE5C\uB2E4. \uBC00\uB808\uB2C8\uC5C4 \uC804\uC57C\uC758 \uADF8 \uC124\uB808\uACE0
        \uB099\uAD00\uC801\uC778 \uACF5\uAE30 \uC18D\uC5D0\uC11C, \uD654\uBA74\uC774
        \uC11C\uC11C\uD788 \uBC1D\uC544\uC9C0\uB4EF \uBBF8\uB798\uB77C\uB294 \uC2DC\uB300\uAC00
        \uC870\uC6A9\uD788 \uC5F4\uB824\uAC04\uB2E4."
      - 
      Flags: 000000000000
      Languages_Touch: []
    - Term: "\u6807\u9898\u66F2"
