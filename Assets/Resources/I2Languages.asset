    - Term: "\u85CF\u4E66\u697C\u7684\u63CF\u8FF0"
      TermType: 0
      Description: 
      Languages:
      - "\u661F\u8FB0\u4E4B\u5854\u77D7\u7ACB\u5728\u8857\u9053\u4E0A\\n\\n\u5979\u4ECE\u67D0\u4E2A\u672A\u77E5\u4E16\u754C\u800C\u6765\\n\u5728\u6DE1\u84DD\u8272\u7684\u5149\u5F71\u4E2D\\n\u6084\u7136\u7B49\u5F85\\n\\n\u63A8\u5F00\u5927\u95E8\u2026\u2026\\n\u8FD9\u4E00\u523B\uFF0C\u4E00\u5B9A\u662F\\n\u547D\u8FD0\u7684\u76F8\u9047"
      - "\u661F\u8FB0\u4E4B\u5854\u77D7\u7ACB\u5728\u8857\u9053\u4E0A\\n\\n\u5979\u5F9E\u67D0\u500B\u672A\u77E5\u4E16\u754C\u800C\u4F86\\n\u5728\u6DE1\u85CD\u8272\u7684\u5149\u5F71\u4E2D\\n\u6084\u7136\u7B49\u5F85\\n\\n\u63A8\u958B\u5927\u9580\u2026\u2026\\n\u9019\u4E00\u523B\uFF0C\u4E00\u5B9A\u662F\\n\u547D\u904B\u7684\u76F8\u9047"
      - "The Tower of Stars stands tall on the street\\n\\nShe comes from unknown
        world\\nSilently waiting in pale blue light and shadow\\n\\nPush open the
        door\u2026\u2026\\nThis moment{c} must be a fateful encounter"
      - "\u661F\u8FB0\u306E\u5854\u304C\u901A\u308A\u306B\u305D\u3073\u3048\u7ACB\u3064\\n\\n\u5F7C\u5973\u306F\u672A\u77E5\u306E\u4E16\u754C\\n\u304B\u3089\u3084\u3063\u3066\u304D\u305F\\n\u6DE1\u3044\u9752\u306E\u5149\u3068\u5F71\u306E\u4E2D\u3067\\n\u9759\u304B\u306B\u5F85\u3064\\n\\n\u5927\u6249\u3092\u958B\u3051\u308B\u3068\u2026\u2026\\n\u3053\u306E\u77AC\u9593\u3001\u5FC5\u305A\\n\u904B\u547D\u306E\u51FA\u4F1A\u3044\u304C\u8A2A\u308C\u308B"
      - "\uBCC4\uC758 \uD0D1\uC774 \uAC70\uB9AC \uC704\uC5D0 \uC6B0\uB69D \uC11C
        \uC788\uB2E4\\n\\n\uADF8\uB140\uB294 \uC54C \uC218 \uC5C6\uB294 \uC138\uACC4\uC5D0\uC11C
        \uC654\uB2E4\\n\uC5F0\uD55C \uD478\uB978\uBE5B \uADF8\uB9BC\uC790 \uC18D\uC5D0\uC11C\\n\uC870\uC6A9\uD788
        \uAE30\uB2E4\uB9AC\uBA70\\n\\n\uBB38\uC744 \uBC00\uC5B4 \uC5F4\uBA74\u2026\u2026\\n\uC774
        \uC21C\uAC04, \uD2C0\uB9BC\uC5C6\uC774\\n\uC6B4\uBA85\uC758 \uB9CC\uB0A8"
      - 
      Flags: 000000000000
      Languages_Touch: []
