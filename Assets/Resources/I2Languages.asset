    - Term: "\u6765\u81EA\u6708\u4EAE\u4E0A\u7684\u602A\u732B\u7684\u97F3\u4E50\u63CF\u8FF0"
      TermType: 0
      Description: 
      Languages:
      - "\u6708\u5149\u6D12\u843D\u5728\u53E4\u8001\u7684\u77F3\u50CF\u4E4B\u4E0A\uFF0C\u5C18\u5C01\u7684\u8BB0\u5FC6\u968F\u7740\u5FAE\u5149\u7F13\u7F13\u82CF\u9192\u3002\u60A0\u8FDC\u800C\u795E\u79D8\u7684\u65CB\u5F8B\u4E4B\u4E0B\uFF0C\u662F\u4E00\u6BB5\u5173\u4E8E\u602A\u732B\u7684\u9884\u8A00\u3002\u81F3\u4E8E\u9884\u8A00\u7684\u7ED3\u5C40\u662F\u4EC0\u4E48\uFF0C\u8DE8\u8D8A\u8FC7\u53BB\u548C\u672A\u6765\uFF0C\u4F60\u7EC8\u5C06\u89C1\u8BC1\u3002"
