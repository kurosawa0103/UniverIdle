    "entries": [
        {
            "key": "SAY.事件.3.",
            "chinese": "沙漠的夜风低低地呼啸着，带起细碎的砂粒滑动。"
        },
        {
            "key": "SAY.事件.307.",
            "chinese": "风沙散去，地平线上一片微弱的灯光闪烁。"
        },
        {
            "key": "SAY.事件.136.",
            "chinese": "有一座小村落静静地屹立在黄沙之间。"
        },
        {
            "key": "SAY.事件.308.",
            "chinese": "这个村子从很久以前就存在于此了。"
        },
        {
            "key": "SAY.事件.248.",
            "chinese": "村子的规模不大。"
        },
        {
            "key": "SAY.事件.240.",
            "chinese": "一直以来，这个村子里有一个传闻。"
        },
        {
            "key": "SAY.事件.137.",
            "chinese": "当流星划过夜空，此时对着天空祈愿。"
        },
        {
            "key": "SAY.事件.138.",
            "chinese": "便会实现自己的愿望。"
        },
        {
            "key": "SAY.事件.247.",
            "chinese": "村子的中央矗立着一座古老的观星台。"
        },
        {
            "key": "SAY.事件.337.",
            "chinese": "石壁已经被岁月磨得光滑平整。"
        },
        {
            "key": "SAY.事件.242.",
            "chinese": "这是很久很久以前村民们为了眺望星空而建造的。"
        },
        {
            "key": "SAY.事件.243.",
            "chinese": "在村子的边缘，有一处坑坑洼洼的地带。"
        },
        {
            "key": "SAY.事件.244.",
            "chinese": "所以被村子里的人们称为“星落之地”。"
        },
        {
            "key": "SAY.事件.245.",
            "chinese": "在这片星落之地里确实存在一些陨石的碎片。"
        },
        {
            "key": "SAY.事件.246.",
            "chinese": "村子里的人们会去那里收集这些碎片。"
        },
        {
            "key": "SAY.事件.250.",
            "chinese": "他们相信这些来自天外的石头是神明的一部分。"
        },
        {
            "key": "SAY.事件.44.",
            "chinese": "每当流星降临的夜晚，他们就会聚集在观星台上。"
        },
        {
            "key": "SAY.事件.252.",
            "chinese": "手中握着小小的陨石碎片，向着夜空祈祷。"
        },
        {
            "key": "SAY.事件.253.",
            "chinese": "他们低声默念着心中的愿望。"
        },
        {
            "key": "SAY.事件.254.",
            "chinese": "有的人祈祷家人平安。"
        },
        {
            "key": "SAY.事件.256.",
            "chinese": "有的人祈祷作物丰收。"
        },
        {
            "key": "SAY.事件.255.",
            "chinese": "也有的人祈祷牲畜健康。"
        },
        {
            "key": "SAY.事件.257.",
            "chinese": "这个仪式把村子里的人们联系在了一起。"
        },
        {
            "key": "SAY.事件.258.",
            "chinese": "也许在那一瞬间，他们失去了作为个体的存在。"
        },
        {
            "key": "SAY.事件.260.",
            "chinese": "汇聚在同一片星空之下。"
        },
        {
            "key": "SAY.事件.259.",
