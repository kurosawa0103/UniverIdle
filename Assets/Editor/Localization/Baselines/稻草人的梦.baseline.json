{
    "csvPath": "E:/MemeEcho/Assets/Resources/Language/稻草人的梦.csv",
    "entries": [
        {
            "key": "SAY.事件.3.",
            "chinese": "田埂上吹来温和而又湿润的风。"
        },
        {
            "key": "SAY.事件.136.",
            "chinese": "那天，村里的孩子们找来了去年的稻草。"
        },
        {
            "key": "SAY.事件.339.",
            "chinese": "他们用稻草扎成一个人形的身体。"
        },
        {
            "key": "SAY.事件.137.",
            "chinese": "又取来破布和一顶旧帽子。"
        },
        {
            "key": "SAY.事件.138.",
            "chinese": "小心地将它竖在田埂的中央。"
        },
        {
            "key": "SAY.事件.340.",
            "chinese": "柔和的春日阳光下"
        },
        {
            "key": "SAY.事件.295.",
            "chinese": "它的影子斜斜地落在尚未拔节的秧苗上。"
        },
        {
            "key": "SAY.事件.341.",
            "chinese": "它就这样诞生了。"
        },
        {
            "key": "SAY.事件.296.",
            "chinese": "它是被造之物，被赋予了守望的使命。"
        },
        {
            "key": "SAY.事件.343.",
            "chinese": "日复一日地在田埂间树立着。"
        },
        {
            "key": "SAY.事件.342.",
            "chinese": "白天，它听着耕作的人们和孩童们的嬉戏声。"
        },
        {
            "key": "SAY.事件.298.",
            "chinese": "夜里，它听着微风，虫鸣，还有从远处隐隐传来的火车汽笛。"
        },
        {
            "key": "SAY.事件.297.",
            "chinese": "它不知道那是什么，但心里生出一种模糊的渴望。"
        },
        {
            "key": "SAY.事件.299.",
            "chinese": "想去看看风吹来的地方。"
        },
        {
            "key": "MENU.事件.152",
            "chinese": "烈日下的稻浪"
        },
        {
            "key": "SAY.事件.145.",
            "chinese": "太阳升得越来越高，青翠的稻秧像波浪般起伏，"
        },
        {
            "key": "SAY.事件.146.",
            "chinese": "稻草人的衣衫被太阳晒得退去了颜色。"
        },
        {
            "key": "SAY.事件.147.",
            "chinese": "鸟儿偶尔停在它的肩上，它已经不害怕稻草人了。"
        },
        {
            "key": "SAY.事件.148.",
            "chinese": "孩子们已经不再来田里了，听说他们好像去了城里。"
        },
        {
            "key": "SAY.事件.149.",
            "chinese": "田埂上只剩下稻草人和从远方吹拂而来的风。"
        },
        {
            "key": "SAY.事件.155.",
            "chinese": "风在它的身体里穿行，带走了一缕稻草。"
        },
        {
            "key": "SAY.事件.301.",
            "chinese": "同样也带出了它未曾说出的梦。"
        },
        {
            "key": "SAY.事件.300.",
            "chinese": "有时，它望见远处刚刚修建的公路上驶过的汽车。"
        },
        {
            "key": "SAY.事件.302.",
            "chinese": "浮光掠过水面微微荡漾，它以为那是通往天空的入口。"
        },
        {
            "key": "MENU.事件.167",
            "chinese": "丰收的季节"
        },
        {
            "key": "SAY.事件.157.",
            "chinese": "镰刀在田间来回穿梭，谷香弥漫在乡间的空气里。"
        },
        {
            "key": "SAY.事件.344.",
            "chinese": "又到了丰收的季节。"
        },
        {
            "key": "SAY.事件.158.",
            "chinese": "人们割下稻穗，推倒稻草。"
        },
        {
            "key": "SAY.事件.244.",
            "chinese": "有人说，它也该换下来了，收进村里的仓库。"
        },
        {
            "key": "SAY.事件.245.",
            "chinese": "可是没人动手。"
        },
        {
            "key": "SAY.事件.303.",
            "chinese": "可大家忙着收成，忙着赶路，这件事便一直搁置了。"
        },
        {
            "key": "SAY.事件.307.",
            "chinese": "于是它被遗留在光秃秃的田埂上。"
        },
        {
            "key": "SAY.事件.306.",
            "chinese": "被秋日的暮色悄悄收走了最后的光。"
        },
        {
            "key": "SAY.事件.305.",
            "chinese": "那一刻，它忽然明白"
        },
        {
            "key": "SAY.事件.304.",
            "chinese": "它守护的，不只是稻谷，还有那些早已离开的身影。"
        },
        {
            "key": "SAY.事件.345.",
            "chinese": "而在这之上，它也守护着自己的未曾说出的梦。"
        },
        {
            "key": "SAY.事件.643.",
            "chinese": "那是飘渺而又遥远的向往，一个它尚未抵达的地方。"
        },
        {
            "key": "MENU.事件.177",
            "chinese": "冬日雪花纷飞"
        },
        {
            "key": "SAY.事件.179.",
            "chinese": "雪落在田野上，掩埋了田埂。"
        },
        {
            "key": "SAY.事件.180.",
            "chinese": "稻草人的身体有点塌陷，支撑它的竹竿已经裂开了。"
        },
        {
            "key": "SAY.事件.346.",
            "chinese": "它的帽子破破烂烂，摇摇欲坠、"
        },
        {
            "key": "SAY.事件.182.",
            "chinese": "它不再直立，只剩半截身子歪歪地埋在积雪中。"
        },
        {
            "key": "SAY.事件.246.",
            "chinese": "夜晚，一只乌鸦停在它的肩上。"
        },
        {
            "key": "SAY.事件.247.",
            "chinese": "它试着抬头，却发出细微的断裂声。"
        },
        {
            "key": "SAY.事件.308.",
            "chinese": "风掠过它的身体，如今的它已经颤颤巍巍。"
        },
        {
            "key": "SAY.事件.347.",
            "chinese": "它感觉自己有点疲倦了。"
        },
        {
            "key": "SAY.事件.310.",
            "chinese": "它倒在了田埂间。"
        },
        {
            "key": "SAY.事件.348.",
            "chinese": "雪花慢慢地覆盖住它的身体。"
        },
        {
            "key": "SAY.事件.309.",
            "chinese": "它终于放下了使命，在积雪下安静地睡去了。"
        },
        {
            "key": "MENU.事件.186",
            "chinese": "积雪消融"
        },
        {
            "key": "SAY.事件.314.",
            "chinese": "雪渐渐停了，田野恢复了宁静。"
        },
        {
            "key": "SAY.事件.315.",
            "chinese": "太阳升起，积雪消融。"
        },
        {
            "key": "SAY.事件.644.",
            "chinese": "风刮过新生的田埂，孩子们又回到了这里。"
        },
        {
            "key": "SAY.事件.351.",
            "chinese": "但是稻草人已经不见了，只留下了一顶破帽子。"
        },
        {
            "key": "SAY.事件.316.",
            "chinese": "在风里，它融入了田埂，成为原野的一部分。"
        },
        {
            "key": "SAY.事件.349.",
            "chinese": "在风里，它已经追随着火车的汽笛声。"
        },
        {
            "key": "SAY.事件.350.",
            "chinese": "在梦里，它已经前往了它所向往的远方。"
        },
        {
            "key": "MENU.事件.322",
            "chinese": "继续安眠"
        },
        {
            "key": "SAY.事件.327.",
            "chinese": "田野静悄悄，冬日的积雪已经融化，风轻轻拂过破碎的稻草。"
        },
        {
            "key": "SAY.事件.328.",
            "chinese": "它已经不再完整，只是风中的一缕存在。"
        },
        {
            "key": "SAY.事件.329.",
            "chinese": "阳光洒在田埂，仿佛再次回想起它曾经的梦。"
        },
        {
            "key": "SAY.事件.330.",
            "chinese": "梦里，它站立在田埂上，感受风、雨和远方的汽笛。"
        },
        {
            "key": "MENU.事件.336",
            "chinese": "风吹过原野"
        },
        {
            "key": "SAY.事件.356.",
            "chinese": "风轻轻吹过原野"
        },
        {
            "key": "SAY.事件.357.",
            "chinese": "仿佛那个追逐远方的梦，从未停下。"
        },
        {
            "key": "MENU.事件.360",
            "chinese": "离开"
        },
        {
            "key": "SAY.事件.365.",
            "chinese": "不再去打搅它了"
        },
        {
            "key": "CHARACTER.稻草人",
            "chinese": "稻草人"
        }
    ]
